# Copy this file to .env.local and fill in real values.
# DATABASE_URL already lives in the auto-generated .env (Prisma CLI convention) — leave it there.

# Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client ID (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Must exactly match an "Authorized redirect URI" on that OAuth client.
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Secret used to sign session JWTs. Generate with: openssl rand -base64 32
JWT_SECRET=

# --- AI providers for Tools > Fix Grammar & Spelling (AI) ---
# Everything below can also be set (or overridden) at runtime from Settings > AI Config, gated by
# ADMIN_EMAIL further down — these env vars are just the deployment's default/fallback. A value
# set via that UI takes priority over the matching env var here; clearing it in the UI falls back
# to whatever's set here again. Leave all of these blank to configure everything through the UI
# instead, or vice versa — either path works standalone.

# Google Gemini API key. Free tier, no card required — get one at https://aistudio.google.com/apikey.
# Leave blank to disable Gemini as an AI provider.
GEMINI_API_KEY=
# Optional — defaults to gemini-3.6-flash if unset.
GEMINI_MODEL=

# Alternative AI provider for the same feature, routed through AgentRouter
# (https://agentrouter.org/) instead of calling Gemini directly. Selected per-user in
# Settings > General > AI Provider. Leave both blank to disable Claude as an AI provider — Gemini
# keeps working either way.
AGENTROUTER_API_KEY=
# Required if AGENTROUTER_API_KEY is set — must be a model your AgentRouter key actually has
# access to (check the AgentRouter console, or GET /v1/models with your key). No safe default:
# unlike Gemini, model availability varies per AgentRouter account/plan.
CLAUDE_MODEL=

# Email of the Google account allowed to view/edit the above from Settings > AI Config (that tab
# is otherwise inert — "Sign in as the deployment admin..." — for everyone else, guests included).
# Leave blank to disable that UI entirely and manage these purely via env vars.
ADMIN_EMAIL=
