# Copy this file to .env.local and fill in real values.
# DATABASE_URL already lives in the auto-generated .env (Prisma CLI convention) — leave it there.

# Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client ID (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Must exactly match an "Authorized redirect URI" on that OAuth client.
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Secret used to sign session JWTs. Generate with: openssl rand -base64 32
JWT_SECRET=
