// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Google Drive is the source of truth for all application data (workspaces, folders, files,
// settings, recents — see src/lib/drive/). The database holds only authentication / account
// identity, plus the deployment-wide AppConfig below (admin AI keys, not per-user data).
//
// The legacy Workspace / Folder / File / SyncFailure / UserSettings tables and the
// User.activeWorkspaceId column still exist in deployed databases: they are read (raw SQL) by
// the one-time per-user copy to Drive in src/lib/drive/legacyMigration.ts. Do NOT generate a
// migration that drops them until every user's data has been verified in Drive.

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  avatarUrl String?
  googleId  String   @unique

  // OAuth credentials the server uses to act on the user's Drive. Never sent to the browser
  // (see userToDto). Refreshed tokens are written back by getDriveClientForUser.
  googleAccessToken     String?
  googleRefreshToken    String?
  googleTokenExpiresAt  DateTime?

  // Promoted admin status. The `ADMIN_EMAIL` account is always treated as admin regardless of
  // this flag (see getAdminUser()) — this field is for admins promoted through the Admin Panel.
  isAdmin Boolean @default(false)
  // Checked on every session lookup (getSessionUser) — takes effect on the blocked user's very
  // next request, no re-login needed.
  blocked Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/**
 * Singleton row (always id "singleton") holding the deployment-wide AI provider config editable
 * from Settings > AI Config — lets the operator (gated by ADMIN_EMAIL) rotate the Gemini/AgentRouter
 * API keys and model ids without redeploying. Any field left null here falls back to the
 * corresponding env var (GEMINI_API_KEY, GEMINI_MODEL, AGENTROUTER_API_KEY, CLAUDE_MODEL), so a
 * deployment that never touches this UI behaves exactly as if this table didn't exist. Plain text,
 * same trust boundary as the .env files these values would otherwise live in.
 */
model AppConfig {
  id String @id @default("singleton")

  geminiApiKey      String?
  geminiModel       String?
  agentRouterApiKey String?
  claudeModel       String?

  updatedAt DateTime @updatedAt
}
